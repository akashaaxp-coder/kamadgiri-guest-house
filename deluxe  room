<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Kamadgiri Guest House | Luxury Rooms & Wedding Hall</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation -->
    <header class="navbar">
        <div class="logo">
            KAMADGIRI
            <span>GUEST HOUSE</span>
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#rooms">Rooms</a>
            <a href="#services">Services</a>
            <a href="#reviews">Reviews</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>


    <!-- Hero Section -->
    <section class="hero" id="home">

        <div class="hero-content">

            <p class="welcome">WELCOME TO KAMADGIRI</p>

            <h1>
                Comfortable Stay.<br>
                Beautiful Memories.
            </h1>

            <p>
                Enjoy comfortable rooms, excellent service
                and a spacious wedding hall for your special moments.
            </p>

            <div class="hero-buttons">
                <a href="#rooms" class="btn primary-btn">
                    View Rooms
                </a>

                <a href="#booking" class="btn secondary-btn">
                    Book Now
                </a>
            </div>

        </div>

    </section>


    <!-- About -->
    <section class="about">

        <div class="section-title">
            <p>ABOUT US</p>
            <h2>Stay With Comfort</h2>
        </div>

        <div class="about-content">

            <div>
                <h3>Welcome to Kamadgiri Guest House</h3>

                <p>
                    Kamadgiri Guest House offers comfortable rooms,
                    a spacious wedding hall and essential facilities
                    for families, couples and guests.
                </p>

                <p>
                    Our goal is to provide a clean, comfortable
                    and pleasant stay for every guest.
                </p>
            </div>

            <div class="about-box">
                <h3>Why Choose Us?</h3>

                <p>✓ Comfortable Rooms</p>
                <p>✓ Spacious Wedding Hall</p>
                <p>✓ Parking Facility</p>
                <p>✓ Free Wi-Fi</p>
            </div>

        </div>

    </section>


    <!-- Rooms -->
    <section class="rooms-section" id="rooms">

        <div class="section-title">
            <p>OUR ACCOMMODATION</p>
            <h2>Rooms & Hall</h2>
        </div>

        <div class="room-container">

            <div class="room-card">

                <img src="room1.jpg" alt="Deluxe Room">

                <div class="room-content">

                    <h3>Deluxe Room</h3>

                    <p>
                        Comfortable and clean room
                        for a relaxing stay.
                    </p>

                    <div class="price">
                        ₹1,000 <span>/ night</span>
                    </div>

                    <a href="#booking" class="card-btn">
                        Book Room
                    </a>

                </div>

            </div>


            <div class="room-card">

                <img src="room2.jpg" alt="Family Room">

                <div class="room-content">

                    <h3>Family Room</h3>

                    <p>
                        Spacious room suitable
                        for families and groups.
                    </p>

                    <div class="price">
                        ₹2,000 <span>/ night</span>
                    </div>

                    <a href="#booking" class="card-btn">
                        Book Room
                    </a>

                </div>

            </div>


            <div class="room-card">

                <img src="hall.jpg" alt="Wedding Hall">

                <div class="room-content">

                    <h3>Wedding Hall</h3>

                    <p>
                        Spacious hall for weddings,
                        parties and special events.
                    </p>

                    <div class="price">
                        ₹10,000 <span>/ day</span>
                    </div>

                    <a href="#booking" class="card-btn">
                        Enquire Now
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- Services -->
    <section class="services-section" id="services">

        <div class="section-title">
            <p>OUR SERVICES</p>
            <h2>Everything You Need</h2>
        </div>

        <div class="services-container">

            <div class="service-card">
                <div class="service-icon">🏨</div>
                <h3>Luxury Rooms</h3>
                <p>
                    Comfortable rooms for a peaceful stay.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon">💍</div>
                <h3>Wedding Hall</h3>
                <p>
                    Spacious hall for weddings and events.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon">🚗</div>
                <h3>Parking</h3>
                <p>
                    Convenient parking facility for guests.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon">📶</div>
                <h3>Free Wi-Fi</h3>
                <p>
                    Stay connected with complimentary Wi-Fi.
                </p>
            </div>

        </div>

    </section>


    <!-- Reviews -->
    <section class="reviews-section" id="reviews">

        <div class="section-title">
            <p>GUEST REVIEWS</p>
            <h2>What Our Guests Say</h2>
        </div>

        <div class="reviews-container">

            <div class="review-card">

                <div class="stars">
                    ★★★★★
                </div>

                <p>
                    "Excellent service and beautiful rooms.
                    We had a very comfortable stay."
                </p>

                <h4>Rahul Sharma</h4>

            </div>


            <div class="review-card">

                <div class="stars">
                    ★★★★★
                </div>

                <p>
                    "The wedding hall is very spacious
                    and perfect for family functions."
                </p>

                <h4>Vinay Singh</h4>

            </div>

        </div>

    </section>


    <!-- Booking -->
    <section class="booking-section" id="booking">

        <div class="section-title">
            <p>RESERVATION</p>
            <h2>Book Your Stay</h2>
        </div>

        <form class="booking-form" id="bookingForm">

            <div class="form-group">

                <label>Your Name</label>

                <input
                    type="text"
                    id="name"
                    placeholder="Enter your name"
                    required
                >

            </div>


            <div class="form-group">

                <label>Phone Number</label>

                <input
                    type="tel"
                    id="phone"
                    placeholder="Enter phone number"
                    required
                >

            </div>


            <div class="form-group">

                <label>Booking Date</label>

                <input
                    type="date"
                    id="date"
                    required
                >

            </div>


            <div class="form-group">

                <label>Number of Guests</label>

                <input
                    type="number"
                    id="guests"
                    placeholder="Number of guests"
                    min="1"
                    required
                >

            </div>


            <div class="form-group full-width">

                <label>Message</label>

                <textarea
                    id="message"
                    placeholder="Room or hall booking details"
                    rows="4">
                </textarea>

            </div>


            <button
                type="submit"
                class="booking-btn">
                Send Booking Request
            </button>

        </form>

    </section>


    <!-- Location -->
    <section class="map-section">

        <div class="section-title">

            <p>FIND US</p>

            <h2>Our Location</h2>

        </div>

        <div class="map-container">

            <a
                href="https://maps.app.goo.gl/zrSoejgzNVgspmb8A"
                target="_blank"
                class="map-link">

                📍 Open Kamadgiri Guest House in Google Maps

            </a>

        </div>

    </section>


    <!-- Contact -->
    <section class="contact-section" id="contact">

        <div class="section-title">

            <p>GET IN TOUCH</p>

            <h2>Contact Us</h2>

        </div>

        <div class="contact-container">

            <div class="contact-card">

                <h3>Call Us</h3>

                <a href="tel:+917800299999">
                    +91 7800299999
                </a>

            </div>


            <div class="contact-card">

                <h3>WhatsApp</h3>

                <a
                    href="https://wa.me/917800296082"
                    target="_blank">

                    Chat on WhatsApp

                </a>

            </div>


            <div class="contact-card">

                <h3>Email</h3>

                <a href="mailto:info@kamadgiri.com">

                    info@kamadgiri.com

                </a>

            </div>

        </div>

    </section>


    <!-- Footer -->
    <footer>

        <div class="footer-content">

            <h2>KAMADGIRI</h2>

            <p>
                Comfortable Rooms • Wedding Hall • Great Service
            </p>

            <p class="copyright">
                © 2026 Kamadgiri Guest House.
                All Rights Reserved.
            </p>

        </div>

    </footer>


    <!-- WhatsApp Floating Button -->

    <a
        href="https://wa.me/917800296082"
        class="whatsapp-float"
        target="_blank"
        aria-label="Chat on WhatsApp">

        WhatsApp

    </a>


    <script src="script.js"></script>

</body>
</html>
